# Copy to .env.local. Never commit real secrets. No secret has a NEXT_PUBLIC_ prefix.
# Development without Supabase defaults to a localhost-only SAMPLE workspace.
APP_MODE=local
APP_URL=http://127.0.0.1:3000

# Production: set APP_MODE=production, HTTPS APP_URL, and all five values below.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exactly 32 random bytes, base64 encoded. Store in a secret manager; back up separately.
DATA_ENCRYPTION_KEY=

# Server-side only. Optional in local mode; manual preparation works without AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Gemini supports explanatory notes only; current voice uses OpenAI above.
GEMINI_API_KEY=
GEMINI_KNOWLEDGE_MODEL=gemini-3.8-flash

# Your approved ERI gateway implementing docs/eri-contract.md, NOT a guessed ITD endpoint.
ERI_GATEWAY_URL=
ERI_GATEWAY_TOKEN=
# Exact comma-separated official redirect hostnames approved during ERI onboarding.
ERI_REDIRECT_HOSTS=

# Normalized server-to-server gateway operated with approved ERI/payroll/financial-data partners.
# See docs/records-contract.md. This is NOT a universal public PAN lookup API.
TAX_DATA_GATEWAY_URL=
TAX_DATA_GATEWAY_TOKEN=
# Exact approved external authorization hosts. Never allow arbitrary redirects.
TAX_DATA_AUTH_HOSTS=

# Required for scheduled retention cleanup. Use a random, long secret.
CRON_SECRET=
# Set true ONLY after deploying and monitoring the authenticated retention job.
DOCUMENT_RETENTION_ENABLED=false
